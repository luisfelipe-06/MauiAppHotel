<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.SobrePage"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Image Source="hotel.png"
                   WidthRequest="120"
                   HeightRequest="120"
                   HorizontalOptions="Center"
                   Margin="0,10,0,25"/>
            <Label Text="Hotel Paradise"
            FontSize="30"
            FontFamily="Kalam"
            HorizontalOptions="Center"
            FontAttributes="Bold"
            TextColor="{StaticResource Primary}"/> 

            <Label Text="Sobre o App Hotel"
                   FontSize="26"
                   FontFamily="Kalam"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource MidnightBlue}"
                   Margin="0,0,0,20"/>

            <Frame Padding="15"
                   BackgroundColor="#eeeeee"
                   CornerRadius="15">

                <VerticalStackLayout Spacing="10">
                    <Label Text="Desenvolvedor: Luís Felipe Miguel Soares"
                           FontSize="18"
                           FontFamily="Kalam"
                           TextColor="{StaticResource Black}"/>

                    <Label Text="Ano de Desenvolvimento: 2025"
                           FontSize="18"
                           FontFamily="Kalam"
                           TextColor="{StaticResource Black}" />

                    <Label Text="Aplicativo desenvolvido para estudo em .NET MAUI."
                           FontSize="16"
                           FontFamily="Kalam"
                           TextColor="{StaticResource Gray400}"/>

                    <Button Text="Voltar"
                            Clicked="Voltar_Clicked"
                            Margin="20" /> 

                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>